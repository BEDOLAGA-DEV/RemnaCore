# CORS is owned by the application (go-chi/cors with the CORS_ALLOWED_ORIGINS
# allowlist), which also answers preflight OPTIONS. Caddy must NOT inject
# Access-Control-Allow-Origin "*" — that overrode the app's allowlist and let any
# origin read API responses. /metrics is intentionally NOT exposed here (it
# leaked internal telemetry unauthenticated); scrape remnacore:4000/metrics on
# the internal network from a Prometheus sidecar instead.

# ── Cabinet SPA + public API/subscription (port 80) ──────────────────────────
:80 {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    handle /api/* {
        reverse_proxy remnacore:4000
    }
    handle /healthz {
        reverse_proxy remnacore:4000
    }
    handle /sub/* {
        reverse_proxy remnacore:4100
    }
    handle {
        root * /srv/cabinet
        try_files {path} /index.html
        file_server
    }
}

# ── Admin SPA + API (port 8081) ──────────────────────────────────────────────
:8081 {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    handle /api/* {
        reverse_proxy remnacore:4000
    }
    handle /readyz {
        reverse_proxy remnacore:4000
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}

# ── Remnawave panel (port 8080) ──────────────────────────────────────────────
:8080 {
    reverse_proxy remnawave-backend:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up Host {upstream_hostport}
    }
    header -Content-Security-Policy
    header -Content-Security-Policy-Report-Only
    header -Strict-Transport-Security
    header -Cross-Origin-Opener-Policy
    header -Origin-Agent-Cluster
    header -X-Content-Type-Options
}
